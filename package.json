{
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "version": "node ./scripts/version.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "lint": "eslint .&&tsc --noemit",
    "eas:build": "eas build -p android --non-interactive",
    "eas:preview": "eas build --profile preview --platform android",
    "eas:submit": "eas submit -p android --latest",
    "eas:deploy": "npm run eas:build&&npm run eas:submit",
    "emulator:list": "%userProfile%\\AppData\\Local\\Android\\sdk\\emulator\\emulator -list-avds",
    "emulator": "start %userProfile%\\AppData\\Local\\Android\\sdk\\emulator\\emulator -avd"
  },
  "dependencies": {
    "@apollo/client": "^3.8.8",
    "@expo/vector-icons": "^15.0.3",
    "@openspacelabs/react-native-zoomable-view": "^2.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "apollo-link-context": "^1.0.20",
    "babel-preset-expo": "~54.0.10",
    "color": "^5.0.0",
    "date-fns": "^2.28.0",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-image-picker": "~17.0.11",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "graphql": "^15.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^5.12.1",
    "i18next": "^25.4.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.2",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-error-boundary": "^1.2.4",
    "react-native-maps": "1.20.1",
    "react-native-paper": "^5.12.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-redux": "^9.2.0",
    "react-router-native": "^6.1.1",
    "redux": "^5.0.0",
    "username-generator": "^1.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@apollo/react-testing": "^4.0.0",
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^4.0.4",
    "@testing-library/react-native": "^9.0.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-dom": "^19.0.0",
    "@types/react-native-table-component": "^1.2.3",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-plugin-react": "^7.28.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "metro-babel-register": "^0.73.3",
    "react-test-renderer": "19.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|color)"
    ],
    "setupFiles": [
      "./src/__tests__/mocks/jestSetupFile.js"
    ],
    "testRegex": "(.*\\.spec\\.(tsx|ts|js)$)"
  },
  "private": true
}
